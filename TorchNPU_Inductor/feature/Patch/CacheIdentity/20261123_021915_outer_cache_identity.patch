+# Copyright (c) 2026, Huawei Technologies Co., Ltd
+#
+"""triton_experimental factors for the outer Inductor cache identity."""
+import hashlib
+import json
+import os
+
+import torch_npu
+from torch._inductor.codecache import CacheBase
+
+from .fx_passes import _te_source_digest
+
+_BACKEND_ENV = "TORCHINDUCTOR_NPU_BACKEND"
+_BACKEND_NAME = "triton_experimental"
+_INSTALLED = None
+
+
+def install_cache_key_factor():
+    global _INSTALLED
+    if _INSTALLED is not None and CacheBase.__dict__.get("get_system") is _INSTALLED:
+        return
+    prev = CacheBase.get_system
+
+    def get_system_with_te_factor():
+        system = prev()
+        if os.environ.get(_BACKEND_ENV) != _BACKEND_NAME:
+            return system
+        system.pop("hash", None)
+        system.setdefault("version", {})[_BACKEND_NAME] = (
+            f"{torch_npu.__version__}:{_te_source_digest().hex()}"
+        )
+        system["hash"] = hashlib.sha256(
+            json.dumps(system, sort_keys=True).encode("utf-8")
+        ).hexdigest()
+        return system
+
+    _INSTALLED = staticmethod(get_system_with_te_factor)
+    CacheBase.get_system = _INSTALLED
