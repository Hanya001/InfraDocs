 class TestPackageSystemIdentity(TestCase):
+    def setUp(self):
+        super().setUp()
+        self._get_system = CacheBase.__dict__["get_system"]
+        self._backend = os.environ.get("TORCHINDUCTOR_NPU_BACKEND")
+
+    def tearDown(self):
+        CacheBase.get_system = self._get_system
+        if self._backend is None:
+            os.environ.pop("TORCHINDUCTOR_NPU_BACKEND", None)
+        else:
+            os.environ["TORCHINDUCTOR_NPU_BACKEND"] = self._backend
+        super().tearDown()
+
+    def test_cache_system_changes_with_te_identity(self):
+        from torch_npu._inductor.triton_experimental import _cache_key
+
+        with mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "default"}):
+            baseline = copy.deepcopy(CacheBase.get_system())
+        _cache_key.install_cache_key_factor()
+        with mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "default"}):
+            self.assertEqual(CacheBase.get_system(), baseline)
+
+        systems = []
+        for version, digest in (("test-a", b"source-a"), ("test-a", b"source-b"), ("test-b", b"source-b")):
+            with (
+                mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "triton_experimental"}),
+                mock.patch.object(torch_npu, "__version__", version),
+                mock.patch.object(_cache_key, "_te_source_digest", return_value=digest),
+            ):
+                systems.append(CacheBase.get_system())
+        self.assertEqual(
+            systems[0]["version"]["triton_experimental"],
+            f"test-a:{b'source-a'.hex()}",
+        )
+        expected_hash = hashlib.sha256(
+            json.dumps(
+                {key: value for key, value in systems[0].items() if key != "hash"},
+                sort_keys=True,
+            ).encode("utf-8")
+        ).hexdigest()
+        self.assertEqual(systems[0]["hash"], expected_hash)
+        self.assertNotEqual(systems[0]["hash"], systems[1]["hash"])
+        self.assertNotEqual(systems[1]["hash"], systems[2]["hash"])
+
+    def test_inductor_adaptor_hash_changes_with_te_identity(self):
+        from vllm.compilation.compiler_interface import InductorAdaptor
+        from torch_npu._inductor.triton_experimental import _cache_key
+
+        _cache_key.install_cache_key_factor()
+        adaptor = InductorAdaptor(use_aot_compile=False)
+        with mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "default"}):
+            baseline = adaptor.compute_hash(None)
+        hashes = []
+        for digest in (b"source-a", b"source-b"):
+            with (
+                mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "triton_experimental"}),
+                mock.patch.object(_cache_key, "_te_source_digest", return_value=digest),
+            ):
+                hashes.append(adaptor.compute_hash(None))
+        self.assertNotEqual(hashes[0], hashes[1])
+        with mock.patch.dict(os.environ, {"TORCHINDUCTOR_NPU_BACKEND": "default"}):
+            self.assertEqual(adaptor.compute_hash(None), baseline)
+
+    def test_cache_key_factor_install_is_idempotent(self):
+        from torch_npu._inductor.triton_experimental import _cache_key
+
+        _cache_key.install_cache_key_factor()
+        installed = CacheBase.__dict__["get_system"]
+        _cache_key.install_cache_key_factor()
+        self.assertIs(CacheBase.__dict__["get_system"], installed)
+
