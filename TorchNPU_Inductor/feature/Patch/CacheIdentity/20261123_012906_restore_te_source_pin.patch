+class TestTeSourcePinPassInjection(FusionChainTestBase):
+    def test_all_flags_off_still_injects_source_pin(self):
+        from torch_npu._inductor.triton_experimental.fx_passes import TeSourcePinPass
+        from vllm.compilation.passes.inductor_pass import CallableInductorPass
+
+        pin_uuid = b"\x00\x01\xfe\xff"
+        with (
+            patch("vllm_ascend.device.device_config.is_310p", return_value=False),
+            patch.object(TeSourcePinPass, "uuid", return_value=pin_uuid),
+        ):
+            manager, _ = self._configure(
+                fuse_norm_quant="false", fuse_qknorm_rope="false", fuse_muls_add="false"
+            )
+
+        wrappers = [p for p in manager.passes if isinstance(p, CallableInductorPass)]
+        self.assertEqual(len(wrappers), 1)
+        self.assertIsInstance(wrappers[0].callable, TeSourcePinPass)
+        self.assertEqual(wrappers[0].uuid(), pin_uuid.hex())
+
+    def test_source_pin_uuid_changes_manager_aggregate_uuid(self):
+        from torch_npu._inductor.triton_experimental.fx_passes import TeSourcePinPass
+
+        with patch.object(TeSourcePinPass, "uuid", return_value=b"\x01" * 32):
+            first, _ = self._configure(
+                fuse_norm_quant="false", fuse_qknorm_rope="false", fuse_muls_add="false"
+            )
+        with patch.object(TeSourcePinPass, "uuid", return_value=b"\x02" * 32):
+            second, _ = self._configure(
+                fuse_norm_quant="false", fuse_qknorm_rope="false", fuse_muls_add="false"
+            )
+
+        self.assertNotEqual(_aggregate_uuid(first), _aggregate_uuid(second))
+
