@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Ascend project
+"""Scope each engine's triton_experimental configuration to Inductor compilation."""
+
+from typing import Any
+
+from torch_npu._inductor.triton_experimental import config as te_config
+from vllm.compilation.compiler_interface import InductorAdaptor
+from vllm.config import VllmConfig
+
+from vllm_ascend.ascend_config import init_ascend_config
+
+_ORIGINAL_COMPUTE_HASH = InductorAdaptor.compute_hash
+_ORIGINAL_COMPILE = InductorAdaptor.compile
+
+
+def compute_hash(self: InductorAdaptor, vllm_config: VllmConfig) -> str:
+    self._triton_experimental_config = dict(
+        init_ascend_config(vllm_config).ascend_compilation_config.triton_experimental_config
+    )
+    return _ORIGINAL_COMPUTE_HASH(self, vllm_config)
+
+
+def compile(
+    self: InductorAdaptor,
+    graph: Any,
+    example_inputs: list[Any],
+    compiler_config: dict[str, Any],
+    compile_range: Any,
+    key: str | None = None,
+) -> tuple[Any, Any]:
+    with te_config.patch(self._triton_experimental_config):
+        return _ORIGINAL_COMPILE(self, graph, example_inputs, compiler_config, compile_range, key)
+
+
+InductorAdaptor.compute_hash = compute_hash
+InductorAdaptor.compile = compile
diff --git a/tests/ut/patch/worker/test_patch_triton_experimental.py b/tests/ut/patch/worker/test_patch_triton_experimental.py
new file mode 100644
index 000000000..a4dbca015
--- /dev/null
+++ b/tests/ut/patch/worker/test_patch_triton_experimental.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Ascend project
+
+import runpy
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+from torch_npu._inductor.triton_experimental import config as te_config
+from vllm.compilation.compiler_interface import InductorAdaptor
+
+PATCH_PATH = Path(__file__).resolve().parents[4] / "vllm_ascend/patch/worker/patch_triton_experimental.py"
+
+
+class TestTritonExperimentalPatch(unittest.TestCase):
+    def setUp(self):
+        self.original_compute_hash = InductorAdaptor.compute_hash
+        self.original_compile = InductorAdaptor.compile
+        self.seen_debug_values = []
+        self.upstream_compute_hash = Mock(return_value="upstream-hash")
+
+        def upstream_compile(adaptor, graph, example_inputs, compiler_config, compile_range, key=None):
+            self.seen_debug_values.append(te_config.debug)
+            if compiler_config.get("raise"):
+                raise RuntimeError("compile failed")
+            return "compiled", key
+
+        self.upstream_compile = Mock(side_effect=upstream_compile)
+        InductorAdaptor.compute_hash = self.upstream_compute_hash
+        InductorAdaptor.compile = self.upstream_compile
+        self.init_ascend_config = Mock(side_effect=lambda config: config.ascend_config)
+        self.init_patcher = patch("vllm_ascend.ascend_config.init_ascend_config", self.init_ascend_config)
+        self.init_patcher.start()
+        runpy.run_path(str(PATCH_PATH))
+
+    def tearDown(self):
+        self.init_patcher.stop()
+        InductorAdaptor.compute_hash = self.original_compute_hash
+        InductorAdaptor.compile = self.original_compile
+
+    @staticmethod
+    def _vllm_config(te_options):
+        return SimpleNamespace(
+            ascend_config=SimpleNamespace(
+                ascend_compilation_config=SimpleNamespace(triton_experimental_config=te_options)
+            )
+        )
+
+    @staticmethod
+    def _compile(adaptor, compiler_config=None):
+        return adaptor.compile(object(), [], compiler_config or {}, object(), key="key")
+
+    def test_compute_hash_copies_engine_config_and_delegates(self):
+        adaptor = InductorAdaptor(use_aot_compile=False)
+        options = {"debug": True}
+        vllm_config = self._vllm_config(options)
+
+        self.assertEqual(adaptor.compute_hash(vllm_config), "upstream-hash")
+        self.assertEqual(adaptor._triton_experimental_config, options)
+        self.assertIsNot(adaptor._triton_experimental_config, options)
+        self.init_ascend_config.assert_called_once_with(vllm_config)
+        self.upstream_compute_hash.assert_called_once_with(adaptor, vllm_config)
+
+    def test_compile_scopes_and_restores_config(self):
+        adaptor = InductorAdaptor(use_aot_compile=False)
+        original_debug = te_config.debug
+        adaptor.compute_hash(self._vllm_config({"debug": not original_debug}))
+
+        self.assertEqual(self._compile(adaptor), ("compiled", "key"))
+        self.assertEqual(self.seen_debug_values, [not original_debug])
+        self.assertEqual(te_config.debug, original_debug)
+
+    def test_compile_restores_config_after_exception(self):
+        adaptor = InductorAdaptor(use_aot_compile=False)
+        original_debug = te_config.debug
+        adaptor.compute_hash(self._vllm_config({"debug": not original_debug}))
+
+        with self.assertRaisesRegex(RuntimeError, "compile failed"):
+            self._compile(adaptor, {"raise": True})
+        self.assertEqual(self.seen_debug_values, [not original_debug])
+        self.assertEqual(te_config.debug, original_debug)
+
+    def test_instances_keep_configs_isolated(self):
+        first = InductorAdaptor(use_aot_compile=False)
+        second = InductorAdaptor(use_aot_compile=False)
+        original_debug = te_config.debug
+        first.compute_hash(self._vllm_config({"debug": not original_debug}))
+        second.compute_hash(self._vllm_config({"debug": original_debug}))
+
+        self._compile(first)
+        self._compile(second)
+        self.assertEqual(self.seen_debug_values, [not original_debug, original_debug])
+        self.assertEqual(te_config.debug, original_debug)
+
+
+if __name__ == "__main__":
+    unittest.main()
