@@ -151,6 +151,25 @@ class AscendCompilationConfig:
     # bit-identical on both tracks (default-off also honors the original
     # hold-design 3.2 "first version off, enable experiment-driven" promise).
     fuse_norm_quant_dynamic: bool = False
+    triton_experimental_config: dict[str, bool | int | float | str | None] = dataclasses.field(default_factory=dict)
+
+    @field_validator("triton_experimental_config")
+    @classmethod
+    def _validate_triton_experimental_config(cls, value: dict[str, bool | int | float | str | None]):
+        if not value:
+            return value
+        from torch_npu._inductor.triton_experimental import config as te_config
+
+        known_keys = te_config.get_config_copy()
+        normalized = {}
+        for key, option in value.items():
+            if key not in known_keys:
+                raise ValueError(f"Unknown triton_experimental_config key: {key!r}")
+            try:
+                normalized[key] = TypeAdapter(te_config.get_type(key)).validate_python(option)
+            except ValueError as exc:
+                raise ValueError(f"Invalid value for triton_experimental_config.{key}: {option!r}") from exc
+        return normalized
 
