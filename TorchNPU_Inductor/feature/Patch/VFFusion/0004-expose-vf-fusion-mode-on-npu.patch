@@ -151,6 +151,7 @@ class AscendCompilationConfig:
     # bit-identical on both tracks (default-off also honors the original
     # hold-design 3.2 "first version off, enable experiment-driven" promise).
     fuse_norm_quant_dynamic: bool = False
+    vf_fusion_mode: Literal["ub-aware-op", "max-parallel"] | None = None
 
     @model_validator(mode="before")
     @classmethod
