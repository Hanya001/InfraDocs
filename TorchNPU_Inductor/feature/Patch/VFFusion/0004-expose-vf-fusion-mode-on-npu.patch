         try:
             from torch_npu._inductor.triton_experimental import config as tn_config
 
+            tn_config.vf_fusion_mode = acc.vf_fusion_mode
             elide_enabled = getattr(tn_config, "elide_int_float_int", False)
         except Exception:  # noqa: BLE001
             elide_enabled = False
+            if acc.vf_fusion_mode is not None:
+                logger.warning("torch_npu VF Fusion mode cannot be configured on this installation; skipping it.")
         if elide_enabled:
