From 88a4a9b31e11806e01c8559605c2cf3a6f0a85e1 Mon Sep 17 00:00:00 2001
From: hanyaZ <zhenghanya1@huawei.com>
Date: Sun, 22 Nov 2026 13:32:40 +0000
Subject: [PATCH] perf(compilation): support Ascend SP in MMRS fusion

Signed-off-by: hanyaZ <zhenghanya1@huawei.com>
---
 .../test_graph_fusion_pass_manager.py         |  4 ++
 .../test_mm_reduce_scatter_fusion_pass.py     | 43 +++++++++++++++---
 .../passes/mm_reduce_scatter_fusion_pass.py   | 45 ++++++++++++++++---
 3 files changed, 79 insertions(+), 13 deletions(-)

diff --git a/tests/ut/compilation/test_graph_fusion_pass_manager.py b/tests/ut/compilation/test_graph_fusion_pass_manager.py
index 1ab7b496b..868d16267 100644
--- a/tests/ut/compilation/test_graph_fusion_pass_manager.py
+++ b/tests/ut/compilation/test_graph_fusion_pass_manager.py
@@ -65,6 +65,10 @@ class TestGraphFusionPassManagerConfig(TestBase):
                 "vllm_ascend.compilation.passes.mm_reduce_scatter_fusion_pass.get_tp_group",
                 return_value=MagicMock(unique_name="tp:0"),
             ),
+            patch(
+                "vllm_ascend.models.common.ops.sequence_parallel.get_tensor_model_parallel_world_size",
+                return_value=2,
+            ),
         ):
             manager = GraphFusionPassManager()
             manager.configure(vllm_config)
diff --git a/tests/ut/compilation/test_mm_reduce_scatter_fusion_pass.py b/tests/ut/compilation/test_mm_reduce_scatter_fusion_pass.py
index 0d379f2ae..44eaab8ea 100644
--- a/tests/ut/compilation/test_mm_reduce_scatter_fusion_pass.py
+++ b/tests/ut/compilation/test_mm_reduce_scatter_fusion_pass.py
@@ -51,6 +51,7 @@ OUTPUT_DIM = 256
 
 GEMM_OP = torch.ops.vllm.unquantized_gemm.default
 REDUCE_SCATTER_OP = torch.ops.vllm.reduce_scatter.default
+ASCEND_SP_REDUCE_SCATTER_OP = torch.ops.vllm.ascend_sp_reduce_scatter_impl.default
 PAD_OP = torch.ops.aten.constant_pad_nd.default
 CAT_OP = torch.ops.aten.cat.default
 FULL_OP = torch.ops.aten.full.default
@@ -74,6 +75,7 @@ def _build_graph(
     use_constant_pad: bool = False,
     pad_value: float = 0.0,
     valid_padding: bool = True,
+    use_ascend_sp: bool = False,
 ) -> fx.GraphModule:
     graph = fx.Graph()
     fake_mode = FakeTensorMode()
@@ -114,12 +116,20 @@ def _build_graph(
             cat_inputs = [zeros, gemm] if reverse_cat_inputs else [gemm, zeros]
             cat_args = (cat_inputs,) if cat_dim == 0 else (cat_inputs, cat_dim)
             scattered = call(CAT_OP, cat_args, reduced_rows, OUTPUT_DIM)
-    reduce_scatter = call(
-        REDUCE_SCATTER_OP,
-        (scattered, dim, world_size, group_name),
-        reduced_rows // TP_SIZE,
-        OUTPUT_DIM,
-    )
+    if use_ascend_sp:
+        reduce_scatter = call(
+            ASCEND_SP_REDUCE_SCATTER_OP,
+            (scattered,),
+            reduced_rows // TP_SIZE,
+            OUTPUT_DIM,
+        )
+    else:
+        reduce_scatter = call(
+            REDUCE_SCATTER_OP,
+            (scattered, dim, world_size, group_name),
+            reduced_rows // TP_SIZE,
+            OUTPUT_DIM,
+        )
     outputs = [reduce_scatter]
     if extra_gemm_user:
         outputs.append(call(torch.ops.aten.clone.default, (gemm,), num_tokens, OUTPUT_DIM))
@@ -131,6 +141,10 @@ def _targets(graph_module: fx.GraphModule) -> list:
     return [node.target for node in graph_module.graph.nodes if node.op == "call_function"]
 
 
+@patch(
+    "vllm_ascend.models.common.ops.sequence_parallel.get_tensor_model_parallel_world_size",
+    new=lambda: TP_SIZE,
+)
 @patch(
     "vllm_ascend.compilation.passes.mm_reduce_scatter_fusion_pass.DeviceOperator.npu_mm_reduce_scatter_base",
     new=_fake_mm_reduce_scatter,
@@ -183,6 +197,23 @@ class TestMatmulReduceScatterFusionPass(TestBase):
         self.assertEqual(_targets(graph_module).count(FUSED_OP), 1)
         self.assertNotIn(PAD_OP, _targets(graph_module))
 
+    def test_ascend_sp_pattern_is_fused_without_padding(self):
+        graph_module = _build_graph(pad_rows=None, use_ascend_sp=True)
+        expected = next(
+            node.meta["val"].shape
+            for node in graph_module.graph.nodes
+            if node.target is ASCEND_SP_REDUCE_SCATTER_OP
+        )
+        self._apply(graph_module)
+
+        self.assertEqual(_targets(graph_module).count(FUSED_OP), 1)
+        self.assertNotIn(ASCEND_SP_REDUCE_SCATTER_OP, _targets(graph_module))
+        self.assertNotIn(GEMM_OP, _targets(graph_module))
+        self.assertNotIn(PAD_OP, _targets(graph_module))
+        fused = next(node for node in graph_module.graph.nodes if node.target is FUSED_OP)
+        self.assertEqual(fused.args[2:4], (HCOM_NAME, TP_SIZE))
+        self.assertEqual(fused.meta["val"].shape, expected)
+
     def test_legacy_constant_pad_pattern_is_fused(self):
         graph_module = _build_graph(use_constant_pad=True)
         self._apply(graph_module)
diff --git a/vllm_ascend/compilation/passes/mm_reduce_scatter_fusion_pass.py b/vllm_ascend/compilation/passes/mm_reduce_scatter_fusion_pass.py
index 076d38aef..bbbf793ca 100644
--- a/vllm_ascend/compilation/passes/mm_reduce_scatter_fusion_pass.py
+++ b/vllm_ascend/compilation/passes/mm_reduce_scatter_fusion_pass.py
@@ -28,6 +28,7 @@ _SUPPORTED_DTYPES = (torch.bfloat16, torch.float16)
 
 _GEMM_OP = torch.ops.vllm.unquantized_gemm.default
 _REDUCE_SCATTER_OP = torch.ops.vllm.reduce_scatter.default
+_ASCEND_SP_REDUCE_SCATTER_OP = torch.ops.vllm.ascend_sp_reduce_scatter_impl.default
 _PAD_OP = torch.ops.aten.constant_pad_nd.default
 _CAT_OP = torch.ops.aten.cat.default
 _FULL_OP = torch.ops.aten.full.default
@@ -91,17 +92,25 @@ class _MatmulReduceScatterPattern(BasePattern):
     def _get_extra_check(self):
         def supported(match: Match) -> bool:
             gemm = next((node for node in match.nodes if node.target is _GEMM_OP), None)
-            reduce_scatter = next((node for node in match.nodes if node.target is _REDUCE_SCATTER_OP), None)
+            reduce_scatter = next(
+                (
+                    node
+                    for node in match.nodes
+                    if node.target in (_REDUCE_SCATTER_OP, _ASCEND_SP_REDUCE_SCATTER_OP)
+                ),
+                None,
+            )
             if gemm is None or reduce_scatter is None:
                 return False
             if _arg(gemm, 2, "bias") is not None:
                 return False
-            if _arg(reduce_scatter, 1, "dim") != 0:
-                return False
-            if _arg(reduce_scatter, 2, "world_size") != self.tp_size:
-                return False
-            if _arg(reduce_scatter, 3, "group_name") != self.group_name:
-                return False
+            if reduce_scatter.target is _REDUCE_SCATTER_OP:
+                if _arg(reduce_scatter, 1, "dim") != 0:
+                    return False
+                if _arg(reduce_scatter, 2, "world_size") != self.tp_size:
+                    return False
+                if _arg(reduce_scatter, 3, "group_name") != self.group_name:
+                    return False
             x, weight = gemm.args[0], gemm.args[1]
             if not isinstance(x, fx.Node) or not isinstance(weight, fx.Node):
                 return False
@@ -146,6 +155,25 @@ class MatmulReduceScatterPattern(_MatmulReduceScatterPattern):
         return replacement
 
 
+class AscendSPMatmulReduceScatterPattern(_MatmulReduceScatterPattern):
+    """Match ``gemm -> ascend_sp_reduce_scatter_impl``."""
+
+    def get_pattern(self):
+        def pattern(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+            gemm = torch.ops.vllm.unquantized_gemm.default(x, weight, None)
+            return torch.ops.vllm.ascend_sp_reduce_scatter_impl.default(gemm)
+
+        return pattern
+
+    def get_replacement(self):
+        def replacement(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+            return DeviceOperator.npu_mm_reduce_scatter_base(
+                x, weight.t(), self.hcom_name, self.tp_size, reduce_op="sum"
+            )
+
+        return replacement
+
+
 class CatPaddedMatmulReduceScatterPattern(_MatmulReduceScatterPattern):
     """Match ``gemm -> cat(gemm, zeros) -> reduce_scatter``.
 
@@ -283,6 +311,9 @@ class MatmulReduceScatterFusionPass(VllmInductorPass):
         MatmulReduceScatterPattern(config, self.tp_size, self.group_name, self.hcom_name).register(
             self.pattern_match_passes
         )
+        AscendSPMatmulReduceScatterPattern(config, self.tp_size, self.group_name, self.hcom_name).register(
+            self.pattern_match_passes
+        )
         CatPaddedMatmulReduceScatterPattern(config, self.tp_size, self.group_name, self.hcom_name).register(
             self.pattern_match_passes
         )
-- 
2.34.1

